{
  "expo": {
    "name": "s-gate",
    "slug": "s-gate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icons/icon.png",
    "scheme": "sgate",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.sgate.app",
      "supportsTablet": true,
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "amazonpay",
          "upi",
          "credpay",
          "bhim",
          "paytmmp",
          "phonepe",
          "tez",
          "navipay",
          "mobikwik",
          "myairtel",
          "popclubapp",
          "super",
          "kiwi"
        ]
      }
    },
    "android": {
      "package": "com.sgate.app",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/icons/adaptive-icon.png"
      },
      "navigationBar": {
        "visible": true,
        "barStyle": "dark-content",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icons/s-gate-logo-without-bg.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./src/assets/images/icon.png",
          "color": "#FFB800",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow S-Gate to use your location to provide local society services."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "63def6ca-70fb-490e-8ccc-89f5f7d9460f"
      }
    }
  }
}
