{
  "expo": {
    "name": "s-gate",
    "slug": "s-gate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icons/s-gate-logo-with-bg.png",
    "scheme": "sgate",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.sgate.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.sgate.app",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/icons/s-gate-logo-with-bg.png"
      },
      "navigationBar": {
        "visible": true,
        "barStyle": "dark-content",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icons/s-gate-logo-with-bg.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./src/assets/images/icon.png",
          "color": "#FFB800",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow S-Gate to use your location to provide local society services."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7286df46-4770-4071-acef-57a0666f0482"
      }
    }
  }
}
